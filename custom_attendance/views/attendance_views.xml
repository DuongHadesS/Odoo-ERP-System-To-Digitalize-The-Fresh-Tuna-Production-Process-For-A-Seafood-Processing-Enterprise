<odoo>
    <!-- Form View -->
    <record id="view_custom_attendance_form" model="ir.ui.view">
    <field name="name">custom.attendance.form</field>
    <field name="model">custom.attendance</field>
    <field name="arch" type="xml">
        <form string="Chấm công">
            <header>
                <button name="action_check_in"
                        type="object"
                        string="🟢 Check In"
                        class="btn-primary"
                        invisible="state == 'checked_in'"/>

                <button name="action_check_out"
                        type="object"
                        string="🔴 Check Out"
                        class="btn-secondary"
                        invisible="state == 'checked_out'"/>
            </header>
            <sheet>
                <group>
                    <field name="employee_id"/>
                    <field name="check_in"/>
                    <field name="check_out"/>
                    <field name="worked_hours" readonly="1"/>
                    <field name="state" readonly="1"/>
                    <field name="latitude" readonly="1"/>
                    <field name="longitude" readonly="1"/>
                    <field name="map_embed" widget="html" readonly="1"/>
                    <button name="action_open_map"
                        type="object"
                        string="Xem trên Map"
                        class="btn-secondary"/>
                </group>
            </sheet>
        </form>
    </field>
</record>


    <!-- Tree/List View -->
    <record id="view_custom_attendance_list" model="ir.ui.view">
        <field name="name">custom.attendance.list</field>
        <field name="model">custom.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="worked_hours"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_custom_attendance" model="ir.actions.act_window">
        <field name="name">Chấm công</field>
        <field name="res_model">custom.attendance</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_custom_attendance_root" name="Chấm công"/>
    <menuitem id="menu_custom_attendance"
              name="Quản lý chấm công"
              parent="menu_custom_attendance_root"
              action="action_custom_attendance"/>
</odoo>
